#include <stdio.h>

#define MAX 100

int heap[MAX];
int size = 0;

void insert(int x) {
    int i = ++size;
    while (i > 1 && x > heap[i/2]) {
        heap[i] = heap[i/2];
        i /= 2;
    }
    heap[i] = x;
}

int delete_max() {
    if (size == 0) {
        printf("Heap empty\n");
        return -1;
    }
    int max = heap[1];
    int x = heap[size--];
    int i = 1, j = 2;
    while (j <= size) {
        if (j < size && heap[j] < heap[j+1]) j++;
        if (x >= heap[j]) break;
        heap[i] = heap[j];
        i = j;
        j = 2 * i;
    }
    heap[i] = x;
    return max;
}

void display() {
    int i;
    if (size == 0) {
        printf("Heap empty\n");
        return;
    }
    printf("Heap: ");
    for (i = 1; i <= size; i++) printf("%d ", heap[i]);
    printf("\n");
}

int main() {
    int ch, x;
    while (1) {
        printf("\n1.Insert 2.DeleteMax 3.Display 4.Exit: ");
        scanf("%d", &ch);
        if (ch == 4) break;
        switch (ch) {
        case 1:
            printf("Enter value: ");
            scanf("%d", &x);
            insert(x);
            break;
        case 2:
            x = delete_max();
            if (x != -1) printf("Deleted max: %d\n", x);
            break;
        case 3:
            display();
            break;
        default:
            printf("Invalid choice\n");
        }
    }
    return 0;
}
